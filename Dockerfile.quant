# Quantisation-only image. Builds AWQ checkpoints; never serves one.
#
# autoawq 0.2.8 (what Dockerfile.gpu pins) ships a qwen2_vl wrapper and NO
# qwen2_5_vl one, so AutoAWQForCausalLM cannot quantise this corpus' base at
# all. 0.2.9 adds awq/models/qwen2_5_vl.py, but it also imports awq/models/
# qwen3.py at package init, which needs a transformers newer than the 4.49.0
# the serving image is pinned to -- and that pin must not move, because 4.50+
# breaks AWQ dispatch for Qwen2.5-VL at inference.
#
# Separating them costs nothing real: quantisation is a one-time OFFLINE
# transform and its output is an ordinary AWQ checkpoint. The serving image is
# untouched, and r3-mergedcontrol -- the zero-scale round trip, served by the
# pinned image and required to reproduce 170.05 -- is what proves a checkpoint
# built here loads identically over there.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Newer than the serving pin ON PURPOSE — see the header. accelerate for the
# sharded bf16 load, peft to attach the adapter before folding it in.
RUN pip install --no-cache-dir \
        "transformers>=4.51,<5" "accelerate>=1.0" "peft>=0.14" \
        autoawq==0.2.9 autoawq-kernels==0.0.9 \
        datasets>=2.20 zstandard qwen-vl-utils>=0.0.8

COPY app ./app
COPY merge_lora.py ./
ENV HF_HOME=/models
